[Unit]
Description=Online SQLite backup for Bitget paper worker
RequiresMountsFor=/var/lib/bitget

[Service]
Type=oneshot
User=bitget
Group=bitget
UMask=0077
EnvironmentFile=-/etc/bitget/backup.env
ExecStart=/usr/bin/python3 /opt/bitget/current/infra/gcp/runtime_ops.py backup
TimeoutStartSec=240
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/bitget/backups /var/lib/bitget/data
